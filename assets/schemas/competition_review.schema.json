{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skill_version", "competition", "findings", "score_radar", "current_strongest_point", "current_weakest_point", "largest_award_level_blocker", "highest_roi_remaining_improvement"],
  "properties": {
    "schema_version": {"type": "integer"},
    "skill_version": {"type": "string"},
    "competition": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "severity", "location", "why_it_matters", "smallest_sufficient_fix", "estimated_scoring_impact", "evidence_anchors"],
        "properties": {
          "issue": {"type": "string"},
          "severity": {"type": "string", "enum": ["CRITICAL", "MAJOR", "MINOR"]},
          "location": {"type": "string"},
          "why_it_matters": {"type": "string"},
          "smallest_sufficient_fix": {"type": "string"},
          "estimated_scoring_impact": {"type": "string"},
          "evidence_anchors": {"type": "array"}
        }
      }
    },
    "score_radar": {
      "type": "object",
      "required": ["problem_understanding", "model_appropriateness", "mathematical_rigor", "implementation", "validation", "innovation", "visualization", "writing", "reproducibility", "overall_coherence"]
    },
    "current_strongest_point": {"type": "string"},
    "current_weakest_point": {"type": "string"},
    "largest_award_level_blocker": {"type": "string"},
    "highest_roi_remaining_improvement": {"type": "string"}
  }
}
