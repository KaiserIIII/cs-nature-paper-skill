{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skill_version", "competition", "risks"],
  "properties": {
    "schema_version": {"type": "integer"},
    "skill_version": {"type": "string"},
    "competition": {"type": "string"},
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "category", "severity", "probability_class", "scoring_impact", "affected_question", "mitigation", "status"],
        "properties": {
          "risk_id": {"type": "string"},
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "probability_class": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "scoring_impact": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
          "affected_question": {"type": "string"},
          "mitigation": {"type": "string"},
          "status": {"type": "string", "enum": ["OPEN", "MITIGATING", "RESOLVED", "ACCEPTED"]}
        }
      }
    }
  }
}
