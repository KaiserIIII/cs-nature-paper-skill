{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "skill_version", "id", "competition", "team_size", "reference_duration_seconds", "phase_mapping", "phases", "control_thresholds", "safety_margins", "node_policies"],
  "properties": {
    "schema_version": {"type": "integer"},
    "skill_version": {"type": "string"},
    "id": {"type": "string"},
    "competition": {"type": "string"},
    "team_size": {"type": "integer"},
    "reference_duration_seconds": {"type": "integer"},
    "phase_mapping": {"type": "string", "enum": ["proportional"]},
    "phases": {"type": "array"},
    "control_thresholds": {"type": "object"},
    "safety_margins": {"type": "object"},
    "node_policies": {"type": "object"}
  }
}
