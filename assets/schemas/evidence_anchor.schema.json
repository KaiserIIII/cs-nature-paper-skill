{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS Nature Paper V3 evidence anchor",
  "type": "object",
  "required": ["anchor_id", "claim_id", "result_id", "source_artifact", "exact_region", "transformation", "command", "exit_status", "code_commit", "config_hash", "environment", "input_hash", "uncertainty", "scope", "status", "verified_utc"],
  "properties": {
    "anchor_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "result_id": {"type": "string", "minLength": 1},
    "source_artifact": {"type": "string", "minLength": 1},
    "exact_region": {"type": "string", "minLength": 1},
    "transformation": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "exit_status": {"type": "integer"},
    "code_commit": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["VERIFIED", "UNVERIFIED", "CONTRADICTS", "QUALIFIES"]},
    "verified_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
