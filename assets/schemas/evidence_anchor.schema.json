{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS Nature Paper V3.1.1 evidence anchor",
  "type": "object",
  "required": ["anchor_id", "claim_id", "result_id", "source_artifact", "exact_region", "transformation", "provenance_level", "uncertainty", "scope", "status"],
  "properties": {
    "anchor_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "result_id": {"type": "string", "minLength": 1},
    "source_artifact": {"type": "string", "minLength": 1},
    "exact_region": {"type": "string", "minLength": 1},
    "transformation": {"type": "string", "minLength": 1},
    "provenance_level": {"enum": ["DECLARED", "OBSERVED", "VERIFIED"]},
    "execution_record_id": {"type": "string"},
    "execution_record": {"type": "string"},
    "artifact_acquisition_record_id": {"type": "string"},
    "artifact_acquisition_record": {"type": "string"},
    "command": {"type": "string"},
    "argv": {"type": "array"},
    "cwd": {"type": "string"},
    "exit_status": {"type": "integer"},
    "started_utc": {"type": "string"},
    "finished_utc": {"type": "string"},
    "stdout_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "code_commit": {"type": "string"},
    "code_version_type": {"enum": ["git_commit", "content_hash", "release_id", "not_applicable"]},
    "code_version": {"type": "string"},
    "config_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {"type": ["string", "object"]},
    "uncertainty": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["DECLARED", "OBSERVED", "VERIFIED", "UNVERIFIED", "CONTRADICTS", "QUALIFIES"]},
    "verified_utc": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "legacy_status": {"type": "string"},
    "migration_state": {"type": "string"},
    "output_artifacts": {"type": "array"},
    "checker": {"type": "string"},
    "checker_required": {"type": "boolean"}
  }
}
